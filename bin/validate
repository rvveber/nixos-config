#!/usr/bin/env sh

set -eu

DIR_BIN=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
DIR_ROOT=$(cd "$DIR_BIN"/.. && pwd -P)
cd "$DIR_ROOT"

if ! command -v nix >/dev/null 2>&1; then
  printf 'ERROR: nix is required to validate this project.\n' >&2
  exit 1
fi

if [ -z "${IN_NIX_SHELL:-}" ]; then
  exec nix develop "path:${DIR_ROOT}/src" --command "${DIR_BIN}/validate"
fi

printf 'Checking Nix structure...\n'
statix check "$DIR_ROOT"
deadnix --fail \
  --exclude src/module/host/select/customization/frontend/wayland-hyprland/rvveber-fhud/src/widgets/vendor \
  "$DIR_ROOT"

printf 'Checking formatting...\n'
find "$DIR_ROOT/src" \
  -path "$DIR_ROOT/src/module/host/select/customization/frontend/wayland-hyprland/rvveber-fhud/src/widgets/vendor" -prune \
  -o -name '*.nix' -exec alejandra --check {} +
stylua --check \
  "$DIR_ROOT/src/module/user/select/customization/application/neovim/rvveber-nvim/src/config/init.lua" \
  "$DIR_ROOT/src/module/user/select/customization/application/neovim/rvveber-nvim/src/config/lua"

printf 'Checking flake outputs...\n'
nix flake check "path:${DIR_ROOT}/src"

printf 'Validation passed.\n'
