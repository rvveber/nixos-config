#!/usr/bin/env sh

# Get the absolute path of the directory containing the script
DIR_BIN=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
# Navigate up one directory from the script directory to get to the project root
DIR_ROOT=$(cd "$DIR_BIN"/.. && pwd -P)
cd "${DIR_ROOT}"

# Fancy up the terminal output
ARROW="➜"
CYAN='\033[0;36m'
RED='\033[0;31m'
GREEN='\033[0;32m'
RESET='\033[0m'

printf "${CYAN}${ARROW} INFO: Updating flake inputs${RESET}\n"
nix flake update --flake "path:${DIR_ROOT}/src" \
	--extra-experimental-features nix-command \
	--extra-experimental-features flakes

printf "${CYAN}${ARROW} INFO: Validating updated configuration${RESET}\n"
${DIR_BIN}/validate
