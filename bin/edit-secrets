#!/usr/bin/env bash
set -e

# edit-secrets
# Usage: ./bin/edit-secrets [path/to/secrets.yaml]

REPO_ROOT="$(dirname "$(dirname "$(readlink -f "$0")")")"

if [ "$#" -gt 1 ]; then
    echo "Usage: $0 [path/to/secrets.yaml]" >&2
    exit 2
fi

if [ "$#" -eq 0 ]; then
    mapfile -d '' OWNER_DIRS < <(
        find "$REPO_ROOT/src/hosts" "$REPO_ROOT/src/users" \
            -mindepth 1 -maxdepth 1 -type d -print0 \
            | sort -z
    )

    if [ "${#OWNER_DIRS[@]}" -eq 0 ]; then
        echo "No hosts or users found below $REPO_ROOT/src." >&2
        exit 1
    fi

    echo "Available secret owners:"
    for index in "${!OWNER_DIRS[@]}"; do
        relative_path="${OWNER_DIRS[$index]#"$REPO_ROOT/src/"}"
        owner_type="${relative_path%%/*}"
        owner_name="${relative_path#*/}"
        config_status=""
        if [ ! -f "${OWNER_DIRS[$index]}/.sops.yaml" ]; then
            config_status=" (create new)"
        fi
        printf '  %d) %s: %s%s\n' \
            "$((index + 1))" "${owner_type%s}" "$owner_name" "$config_status"
    done

    while true; do
        read -r -p "Select a secret owner [1-${#OWNER_DIRS[@]}]: " selection
        if [[ "$selection" =~ ^[0-9]+$ ]] \
            && [ "$selection" -ge 1 ] \
            && [ "$selection" -le "${#OWNER_DIRS[@]}" ]; then
            set -- "${OWNER_DIRS[$((selection - 1))]}/secrets.yaml"
            break
        fi
        echo "Invalid selection." >&2
    done
fi

# 1. Determine the key path.
# We prioritize the system's SSH Host Key because that's what we configured in .sops.yaml for this machine.
HOST_KEY_PATH="/etc/ssh/ssh_host_ed25519_key"

if [ -f "$HOST_KEY_PATH" ] && sudo test -r "$HOST_KEY_PATH"; then
    echo "🔑 Using System Host Key: $HOST_KEY_PATH"
    # We use sudo to read the private key, but we run the conversion and sops as the normal user.
    # Note: ssh-to-age reads from stdin if no file is passed, which is safer than temp files.
    SOPS_AGE_KEY="$(sudo cat "$HOST_KEY_PATH" | nix shell nixpkgs#ssh-to-age -c ssh-to-age -private-key)"
    export SOPS_AGE_KEY

else
    echo "⚠️  No SSH Host keys found ($HOST_KEY_PATH) or not readable."
    echo "   Falling back to default SOPS behavior (looking for keys.txt)..."
fi

# 2. Run SOPS
# We must point SOPS to the config file location since it's no longer at the root
# Requires sops >= 3.8.0 for --config
SECRET_DIR="$(dirname "$1")"
SOPS_CONFIG="$SECRET_DIR/.sops.yaml"

if [ ! -d "$SECRET_DIR" ]; then
    echo "Secret owner directory not found: $SECRET_DIR" >&2
    exit 1
fi

if [ ! -f "$SOPS_CONFIG" ]; then
    HOST_PUBLIC_KEY_PATH="/etc/ssh/ssh_host_ed25519_key.pub"
    if [ ! -r "$HOST_PUBLIC_KEY_PATH" ]; then
        echo "Cannot create $SOPS_CONFIG without $HOST_PUBLIC_KEY_PATH." >&2
        exit 1
    fi

    AGE_RECIPIENT="$(
        nix shell nixpkgs#ssh-to-age -c \
            ssh-to-age -i "$HOST_PUBLIC_KEY_PATH"
    )"

    printf '%s\n' \
        'creation_rules:' \
        '  - path_regex: secrets.yaml$' \
        '    key_groups:' \
        '      - age:' \
        "          - \"$AGE_RECIPIENT\"" \
        > "$SOPS_CONFIG"
    chmod 0644 "$SOPS_CONFIG"
    echo "🔑 Created $SOPS_CONFIG for this machine."
fi

if [ -f "$1" ]; then
    echo "🔑 Synchronizing recipients from $SOPS_CONFIG..."
    nix shell nixpkgs#sops -c sops --config "$SOPS_CONFIG" updatekeys --yes "$1"
else
    echo "📄 Creating new secret file: $1"
fi

echo "🔓 Opening SOPS editor (using config: $SOPS_CONFIG)..."
nix shell nixpkgs#sops -c sops --config "$SOPS_CONFIG" "$1"
